{
  "name": "yanji-platform",
  "version": "0.1.0",
  "private": true,
  "description": "研迹：学生月度成果与导师指导平台",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.15.0 <27",
    "pnpm": ">=11.25.0 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @yanji/contracts build && pnpm --parallel --filter @yanji/api --filter @yanji/web dev",
    "build": "pnpm -r --if-present build",
    "pretypecheck": "pnpm --filter @yanji/contracts build",
    "typecheck": "pnpm -r --if-present typecheck",
    "pretest": "pnpm --filter @yanji/contracts build",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
